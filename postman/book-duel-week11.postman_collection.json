                  "});\r",
                  "pm.test(\"game is waiting and has a six-digit code\", function () {\r",
                  "  const body = pm.response.json();\r",
                  "  pm.expect(body.status).to.eql(\"waiting\");\r",
                  "  pm.expect(body.code).to.match(/^[1-9][0-9]{5}$/);\r",
                  "});\r",
                  "pm.collectionVariables.set(\"code\", pm.response.json().code);"
